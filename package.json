{
  "name": "@vulinh1704/mantis",
  "version": "0.4.0",
  "description": "Catches the UI bugs your coding agent can't see, and the ones it hides: every viewport x color scheme x locale in a real browser, cover-up detection, your house style, before/after proof. Agent skills + CLI.",
  "type": "module",
  "bin": {
    "mantis": "bin/mantis.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "plugins/mantis/skills",
    "assets/mantis-128.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve:buggy": "node test/helpers/static-server.js fixtures/buggy-app 4321",
    "serve:clean": "node test/helpers/static-server.js fixtures/clean-app 4322"
  },
  "keywords": [
    "agent",
    "skills",
    "claude-code",
    "ui",
    "visual-testing",
    "accessibility",
    "dark-mode",
    "i18n",
    "playwright",
    "screenshots"
  ],
  "author": "Truong Dang Vu Linh",
  "license": "MIT",
  "homepage": "https://github.com/vulinh1704/mantis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulinh1704/mantis.git"
  },
  "bugs": {
    "url": "https://github.com/vulinh1704/mantis/issues"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
