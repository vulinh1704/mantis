diff --git a/css/components.css b/css/components.css
index 093993e..15c25f8 100644
--- a/css/components.css
+++ b/css/components.css
@@ -1,5 +1,5 @@
 /* Header */
-.site-header { border-bottom: 1px solid var(--border); background: var(--bg); }
+.site-header { position: relative; border-bottom: 1px solid var(--border); background: var(--bg); }
 .site-header .container { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
 .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--text); text-decoration: none; }
 .brand img { width: 28px; height: 28px; }
@@ -13,23 +13,23 @@
 }
 
 /* Filter toolbar */
-.filters { display: flex; gap: 8px; padding: 12px 0; }
+.filters { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 0; }
 .filters button { flex: none; white-space: nowrap; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font: inherit; font-size: 15px; }
 .filters button[aria-pressed="true"] { background: var(--brand); color: var(--brand-ink); border-color: var(--brand); }
 
 /* Cards */
 .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; color: var(--text); }
 .card h3 { margin: 0 0 6px; font-size: 18px; }
-.card--promo { --surface: #ffffff; border-color: var(--brand); }
+.card--promo { background: color-mix(in srgb, var(--brand) 10%, var(--surface)); border-color: var(--brand); }
 
 /* Plans */
 .plan { display: flex; flex-direction: column; gap: 8px; }
-.plan__name { font-size: 20px; font-weight: 700; line-height: 1.4; height: 1.4em; overflow: hidden; margin: 0; }
+.plan__name { font-size: 20px; font-weight: 700; line-height: 1.4; min-height: 2.8em; margin: 0; }
 .plan__price { font-size: 28px; font-weight: 800; letter-spacing: -0.02em; }
 
 /* Social links */
 .social { display: flex; gap: 4px; }
-.social a { display: inline-flex; width: 18px; height: 18px; color: var(--text-muted); }
+.social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--text-muted); }
 .social svg { width: 18px; height: 18px; }
 
 /* Pricing art */
